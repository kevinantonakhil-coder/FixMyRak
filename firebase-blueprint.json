{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "assignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Report": {
      "title": "Report",
      "description": "Community infrastructure report in Ras Al Khaimah",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorEmail": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "minLength": 3, "maxLength": 150 },
        "description": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "category": {
          "type": "string",
          "enum": [
            "Roads and Potholes",
            "Streetlights",
            "Waste Management",
            "Pavements",
            "Public Facilities",
            "Other Infrastructure"
          ]
        },
        "location": { "type": "string", "minLength": 3, "maxLength": 200 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "imageURL": { "type": "string", "maxLength": 2000000 },
        "status": {
          "type": "string",
          "enum": ["Submitted", "Under Review", "In Progress", "Resolved"]
        },
        "isVerified": { "type": "boolean" },
        "flagged": { "type": "boolean" },
        "aiSummary": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "description", "category", "location", "latitude", "longitude", "status", "createdAt"]
    },
    "ReportUpdate": {
      "title": "ReportUpdate",
      "description": "Administrative update on report status",
      "type": "object",
      "properties": {
        "updateId": { "type": "string", "maxLength": 128 },
        "reportId": { "type": "string", "maxLength": 128 },
        "previousStatus": { "type": "string", "maxLength": 50 },
        "newStatus": { "type": "string", "maxLength": 50 },
        "message": { "type": "string", "maxLength": 1000 },
        "adminId": { "type": "string", "maxLength": 128 },
        "adminName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportId", "newStatus", "adminId", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification for status updates",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "reportId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "read", "createdAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User platform feedback and rating",
      "type": "object",
      "properties": {
        "feedbackId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "message": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["rating", "message", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profile data"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Stores administrator authorization IDs"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Public community infrastructure reports"
    },
    "/reports/{reportId}/updates/{updateId}": {
      "schema": { "$ref": "#/entities/ReportUpdate" },
      "description": "Administrative updates for a report"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications for report activity"
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/Feedback" },
      "description": "Platform feedback submitted by users"
    }
  }
}
